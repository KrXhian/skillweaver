{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skillweaver",
  "version": "0.1.0",
  "identifier": "com.skillweaver.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Skillweaver",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
